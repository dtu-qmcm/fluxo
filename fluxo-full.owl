        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <rdfs:label xml:lang="en">ends after</rdfs:label>
