                                <swrl:propertyPredicate rdf:resource="http://purl.obolibrary.org/obo/RO_0002025"/>
                                <swrl:argument1 rdf:resource="urn:swrl:var#mf"/>
                                <swrl:argument2 rdf:resource="urn:swrl:var#eff"/>
                            </rdf:Description>
                        </rdf:first>
