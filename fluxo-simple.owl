        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000021"/>
        <obo:IAO_0000115>A fluxomics method that uses mathematically defined rate laws and ordinary differential equations (ODEs) to simulate reaction rates and metabolite concentrations as a function of enzyme parameters, substrate availability, and regulatory interactions.</obo:IAO_0000115>
        <rdfs:label>kinetic modeling fluxomics method</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000295 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000295">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000041"/>
        <obo:IAO_0000115>An isotope-based metabolic flux analysis method that determines absolute intracellular reaction rates by measuring the transient, time-dependent incorporation or decay of an isotopic tracer into specific metabolite pools immediately following a step-change in labeling.</obo:IAO_0000115>
        <rdfs:label>kinetic flux profiling method</rdfs:label>
    </owl:Class>
    


