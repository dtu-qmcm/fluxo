    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000270">
        <obo:IAO_0000115>A quality that describes the physical (e.g. structural) or chemical properties of molecules, or parts of a molecule.</obo:IAO_0000115>
        <rdfs:label>molecule property</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000271 -->

