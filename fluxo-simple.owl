            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A role of a sample that consists of independent biological replicates made from different individual biosamples.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://www.ebi.ac.uk/efo/EFO_0002091</oboInOwl:hasDbXref>
        <rdfs:label>biological replicate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000294 -->

