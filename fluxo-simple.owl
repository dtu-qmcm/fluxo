                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000021"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The fluxomics software specifically designed to quantitatively estimate intracellular metabolic fluxes from an isotopic metabolic flux analysis investigation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>MFA Software</oboInOwl:hasExactSynonym>
        <rdfs:label>metabolic flux analysis software</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000104 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000104">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is a MATLAB-based software for estimating TCA cycle fluxes from 13C NMR isotopomer data (Chance et al., J Biol Chem, 1983; Malloy et al., Am J Physiol, 1990).</obo:IAO_0000115>
        <rdfs:comment>SIM performs forward simulation of isotopic labeling in the citric acid cycle; tcaCALC performs flux calculation by fitting simulated isotopomer patterns to observed NMR data.</rdfs:comment>
        <rdfs:label>tcaCALC &amp; SIM</rdfs:label>
        <rdfs:seeAlso>https://invivometabolism.org/tca.html</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000105 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is a universal software framework for 13C-based metabolic flux analysis that supports modeling, simulation, design, evaluation, and statistical analysis of 13C-labeling experiments using a cumomer-based simulation approach (Wiechert et al., Metab Eng, 2001, DOI: 10.1006/mben.2001.0188).</obo:IAO_0000115>
        <rdfs:label>13CFLUX</rdfs:label>
        <foaf:homepage>https://www.13cflux.net/13cflux/index.html</foaf:homepage>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000106 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is a third-generation, high-performance simulator supporting both isotopically stationary and non-stationary 13C-MFA, featuring dual EMU/cumomer representations, multi-isotope tracer support, Bayesian uncertainty quantification, and a Python API (Stratmann et al., Bioinformatics, 2025, DOI: 10.1093/bioinformatics/btaf630).</obo:IAO_0000115>
        <rdfs:label>13CFLUXv3</rdfs:label>
        <foaf:homepage>https://x3cflux.readthedocs.io/en/latest/</foaf:homepage>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000107 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that for estimating metabolic fluxes from stationary isotopic labeling data using the NLSIC algorithm, which provides more reliable convergence and better numerical accuracy than other optimization methods (Sokol et al., Bioinformatics, 2012, DOI: 10.1093/bioinformatics/bts705).</obo:IAO_0000115>
        <rdfs:label>influx_s</rdfs:label>
        <rdfs:seeAlso>https://influx-si.readthedocs.io/en/latest/intro.html#influx-s</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000108 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000108">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is an extended version of influx_s that handles isotopically non-stationary labeling experiments, sharing the same NLSIC fitting algorithm and input/output formats with unconditional stability during ODE solving (Sokol et al., Bioinformatics, 2012, DOI: 10.1093/bioinformatics/bts705).</obo:IAO_0000115>
        <rdfs:label>influx_si</rdfs:label>
        <rdfs:seeAlso>https://influx-si.readthedocs.io/en/latest/index.html</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000109 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is an updated MATLAB-based 13C MFA software building on the INCA platform, supporting both steady-state and isotopically non-stationary MFA with the EMU framework, parallel labeling experiments, and improved computational capabilities (Young, Bioinformatics, 2014, DOI: 10.1093/bioinformatics/btu015).</obo:IAO_0000115>
        <rdfs:label>INCA2</rdfs:label>
        <foaf:homepage>https://mfa.vueinnovations.com/</foaf:homepage>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000110 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000110">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is an open-source MATLAB-based software for both conventional and isotopically nonstationary 13C-MFA, featuring auto-generation of metabolic models from Excel configuration worksheets and using the Levenberg-Marquardt method for flux estimation (Kajihata et al., BioMed Res Int, 2014, DOI: 10.1155/2014/627014).</obo:IAO_0000115>
        <rdfs:label>Open Mebius</rdfs:label>
        <foaf:homepage>https://en.metabolic-engineering.jp/page/software/openmebius</foaf:homepage>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000111 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is an open-source Python package for 13C-MFA supporting the EMU framework, INST-MFA, parallel labeling experiments, and a Bayesian Metropolis-Hastings approach, providing flexibility for custom analysis workflows and experimental design via simulation (Matsuda et al., Metab Eng Commun, 2021, DOI: 10.1016/j.mec.2021.e00177).</obo:IAO_0000115>
        <rdfs:label>mfapy</rdfs:label>
        <foaf:homepage>https://github.com/fumiomatsuda/mfapy</foaf:homepage>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000112 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is an extended version of OpenFLUX with support for parallel labeling experiments, extended statistical analysis, structural identifiability analysis, Monte Carlo confidence interval estimation, and experimental design optimization (Shupletsov et al., Microb Cell Fact, 2014, DOI: 10.1186/s12934-014-0152-x).</obo:IAO_0000115>
        <rdfs:label>OpenFLUX2</rdfs:label>
        <foaf:homepage>https://sourceforge.net/projects/openflux2/</foaf:homepage>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is a Scilab-based open-source software for 13C metabolic flux analysis that provides tools for isotopomer modeling and flux estimation.</obo:IAO_0000115>
        <rdfs:label>sysmetab</rdfs:label>
        <foaf:homepage>https://gitlab.com/scilab/forge/sysmetab/</foaf:homepage>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000114 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is a MATLAB-based 13C MFA software with graphical user interface that supports steady-state 13C-MFA with user-friendly data input and flux visualization (He et al., Biotechnol Bioeng, 2016, DOI: 10.1002/bit.25958).</obo:IAO_0000115>
        <rdfs:label>WUFlux</rdfs:label>
        <rdfs:seeAlso>https://tang.eece.wustl.edu/ToolDevelopment.html</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000115 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is a Python-based software package for stationary 13C metabolic flux analysis to estimate intracellular flux distributions.</obo:IAO_0000115>
        <rdfs:label>FluxPyt</rdfs:label>
        <foaf:homepage>https://sourceforge.net/projects/fluxpyt</foaf:homepage>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000116 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is an EMU-based isotope simulator that uses adjacency matrix representation to efficiently simulate isotopic labeling patterns, enabling rapid forward simulation of mass isotopomer distributions for metabolic flux analysis and experimental design (Wu et al., Front Microbiol, 2019, DOI: 10.3389/fmicb.2019.00922).</obo:IAO_0000115>
        <rdfs:label>EMUlator</rdfs:label>
        <rdfs:seeAlso>https://doi.org/10.3389/fmicb.2019.00922</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000117 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000117">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is a Python package for 13C metabolic flux analysis at both isotopic steady state and transient state, supporting flux estimation, labeling pattern simulation, flux balance/variability analysis, and 15N labeling data (Wu et al., ACS Synth Biol, 2023, DOI: 10.1021/acssynbio.3c00265).</obo:IAO_0000115>
        <rdfs:label>freeflux</rdfs:label>
        <foaf:homepage>https://github.com/Chaowu88/freeflux</foaf:homepage>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000118 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is a MATLAB-based software that formulates isotope-assisted MFA as an equality-constrained nonlinear program, improving scalability and robustness compared to traditional formulations (Lugar and Sriram, PLOS Comput Biol, 2022, DOI: 10.1371/journal.pcbi.1009831).</obo:IAO_0000115>
        <rdfs:label>eiFlux</rdfs:label>
        <rdfs:seeAlso>https://doi.org/10.1371/journal.pcbi.1009831</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000119 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is a web-based server for INST-13C MFA with standardized and visual flux analysis, using evolutionary optimization in parallel and providing real-time visualization of the flux optimization process (Liu et al., Bioinformatics, 2022, DOI: 10.1093/bioinformatics/btac341).</obo:IAO_0000115>
        <rdfs:label>CeCaFlux</rdfs:label>
        <foaf:homepage>https://github.com/zhzhd82/CeCaFLUX</foaf:homepage>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000120 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000120">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is an open-source software library for Bayesian genome-scale 13C metabolic flux analysis, using MCMC Bayesian inference with COBRApy for handling genome-scale models and supporting Two Scale 13C MFA (Backman et al., PLOS Comput Biol, 2023, DOI: 10.1371/journal.pcbi.1011111).</obo:IAO_0000115>
        <rdfs:label>BayFlux</rdfs:label>
        <foaf:homepage>https://github.com/JBEI/bayflux</foaf:homepage>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000121 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000121">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0017002"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000230"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A data format specification for defining metabolic models and experimental data used by the FreeFlux software package.</obo:IAO_0000115>
        <rdfs:label>Freeflux specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000122 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000122">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0017002"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000231"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A data format specification for defining metabolic models and experimental data used by the INCA software package.</obo:IAO_0000115>
        <rdfs:label>INCA specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000123 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000123">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A data item which represents the speed of a metabolic reaction.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>flux</oboInOwl:hasExactSynonym>
        <rdfs:comment>it is commonly refer to flux in MFA, even though formally it is a rate. The actual definition of metabolic flux is the amount of metabolite which is converted per time unit. It is calculated as the reaction rate times stoichiometric coefficient, often normalized to a specific quantity (e.g. cell dry weight or volume of a compartment)</rdfs:comment>
        <rdfs:label>metabolic flux</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000124 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000124">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000004"/>
        <obo:IAO_0000115>The metabolic flux of a metabolic reaction that occurs across metabolic network model boundaries.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>boundary flux</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>external rate</oboInOwl:hasExactSynonym>
        <rdfs:comment>In the FBA field, the exchange flux means the external flux.</rdfs:comment>
        <rdfs:label>external flux</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000125 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000125">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000198"/>
        <obo:IAO_0000115>A system biology representation that is a model representation of metabolism, which describes the biochemical reactions occurring within a cell or organism, connecting its genome to its physiology.</obo:IAO_0000115>
        <rdfs:label>metabolic model</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000126 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000126">
        <obo:IAO_0000115>A process that is the set of physical or chemical processes that occur within a living organism in order to maintain life.</obo:IAO_0000115>
        <rdfs:label>metabolism</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000127 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000127">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000125"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0017002"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000278"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A metabolic model that represents a set of interconnected pathways of metabolic reactions within a biological entity.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>network</oboInOwl:hasExactSynonym>
        <rdfs:label>metabolic network model</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000128 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000128">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000005"/>
        <obo:IAO_0000115>A metabolic reaction that is the transfer of a metabolite or metabolites between two compartments.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>transport reaction</oboInOwl:hasExactSynonym>
        <rdfs:label>transport process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000129 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000129">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000198"/>
        <obo:IAO_0000115>A system biology representation that is an imaginary construct of a molecular entity that exist purely for modeling reasons (e.g. biomass).</obo:IAO_0000115>
        <rdfs:label>pseudomolecule</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000130 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000130">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000028"/>
        <obo:IAO_0000115>A exchange flux that represents the minimum of the forward and backward fluxes of a chemical reaction, calculated by convention as a/(1+a), where a is the exchange flux.</obo:IAO_0000115>
        <rdfs:label>relative exchange flux</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000131 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000131">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000174"/>
        <obo:IAO_0000112>In MS, this is the output of the natural isotope abundance correction.</obo:IAO_0000112>
        <obo:IAO_0000115>An isotopologue that differs only in isotopic composition by a single element (e.g. 13C-1-glucose and 13C-2-glucose).</obo:IAO_0000115>
        <rdfs:label>tracer isotopologue</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000132 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000132">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000079"/>
        <obo:IAO_0000115>An isotopic tracer property that denotes the labelled chemical element for the fluxomics investigation (e.g. Carbon in a 13C labelled molecular entity).</obo:IAO_0000115>
        <rdfs:label>tracer element</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000133 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000133">
        <obo:IAO_0000115>A data entity that describes the total number of heavy particles (protons and neutrons jointly called nucleons) in the atomic nucleus.</obo:IAO_0000115>
        <obo:IAO_0000116>Duplicate of monoisotopic molecular mass. Maybe make it broad synonym?</obo:IAO_0000116>
        <oboInOwl:hasExactSynonym>nucleon number</oboInOwl:hasExactSynonym>
        <rdfs:comment>Symbol m in mass spectrometry.</rdfs:comment>
        <rdfs:label>mass number</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000134 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000134">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000171"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000079"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A molecular entity with isotopic tracer at specific atom number(s).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>isotopically labelled molecule</oboInOwl:hasExactSynonym>
        <rdfs:label>isotopically labelled molecular entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000135 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000135">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000134"/>
        <obo:IAO_0000112>e.g. the purchased [1-¹³C]glucose with purity of 99 atom % 13C.</obo:IAO_0000112>
        <obo:IAO_0000115>An isotopically labelled molecular entity that is the market version of the isotopically labelled molecule with manufacturer, purity and cost properties.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>commercially labelled molecule</oboInOwl:hasExactSynonym>
        <rdfs:label>commercial isotopically labelled molecular entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000136 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000136">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000141"/>
        <obo:IAO_0000115>An isotopic information that is the input of the labelled source for the metabolic network model.</obo:IAO_0000115>
        <rdfs:label>label input</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000137 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000137">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000079"/>
        <obo:IAO_0000115>An isotopic tracer property that specifies the atom number of the isotopic tracer in the isotopically labelled molecular entity.</obo:IAO_0000115>
        <rdfs:label>tracer position</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000138 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000138">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000136"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An isotopic tracer property that is the percentage of isotopically labelled molecular entity in a labelled source.</obo:IAO_0000115>
        <rdfs:label>label input proportion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000139 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000139">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000079"/>
        <obo:IAO_0000112>e.g. the isotopic purity for 1,2-13C-Glucose is 99% on position 1 and 2.</obo:IAO_0000112>
        <obo:IAO_0000115>An isotopic tracer property that specifies the purity of the isotopic tracer in the commercial isotopically labelled molecular entity.</obo:IAO_0000115>
        <rdfs:label>tracer isotopic purity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000140 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000140">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000141"/>
        <obo:IAO_0000115>An isotopic information that is the average fraction of isotopically labeled atoms in a metabolite pool, calculated as the weighted sum of isotopologue abundances divided by the maximum possible number of label incorporations.</obo:IAO_0000115>
        <rdfs:comment>Pierre: An average content of isotopic tracer element in the molecule that is calculated from isotopologue distribution.</rdfs:comment>
        <rdfs:label>mean enrichment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000141 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000141">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0017002"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000171"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An information entity that contains details necessary to describe isotope or isotopologue information.</obo:IAO_0000115>
        <rdfs:label>isotopic information</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000142 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000142">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000141"/>
        <obo:IAO_0000112>e.g. percentage of 1,13C-Glucose in the total pool of Glucose in labbel input.</obo:IAO_0000112>
        <obo:IAO_0000115>An isotopic information that describes the isotopic content of the molecule.</obo:IAO_0000115>
        <rdfs:label>isotopic composition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000143 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000141"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0017010"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000150"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An isotopic information that is the relative abundances of molecule isotopologues.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>ID</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>MDV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>MID</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>isotopologue fractional abundance</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mass ditribution vector</oboInOwl:hasExactSynonym>
        <rdfs:label>isotopologue distribution</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000144 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000144">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000141"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0017010"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An isotopic information that is the abundance of isotopomers relative to the abundance of the complete set or subset of isotopic species.</obo:IAO_0000115>
        <rdfs:label>isotopomer distribution</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000145 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000145">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000141"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0017010"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000149"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An isotopic information that is the abundance of cumomer relative to the abundance of the complete set or subset of isotopic species.</obo:IAO_0000115>
        <rdfs:label>cumomer distribution</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000146 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000146">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000226"/>
        <obo:IAO_0000115>A representation that is of isotopic state of a metabolite.</obo:IAO_0000115>
        <rdfs:label>isotopic state-space representation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000147 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000147">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000226"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000301"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000031"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A representation that is the space of all isotopic forms of a metabolite.</obo:IAO_0000115>
        <rdfs:label>isotopic state-space</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000148 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000148">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000146"/>
        <obo:IAO_0000115>An isotopic state-space representation that models positional labeling by a binary number (0: non-labeled, 1: labeled).</obo:IAO_0000115>
        <rdfs:label>isotopomer representation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000149 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000149">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000146"/>
        <obo:IAO_0000115>An isotopic state-space representation that models positional labeling by a state based on three possibilities: 0 represents unlabeled, 1 represents labeled or x: either labeled or unlabeled.</obo:IAO_0000115>
        <rdfs:label>cumomer representation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000150 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000150">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000146"/>
        <obo:IAO_0000115>An isotopic state-space representation that models the mass differences due to labeling of a compound fragment. The fragment is defined by a binary number (position is/is not part of the fragment).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>EMU</oboInOwl:hasExactSynonym>
        <rdfs:label>elementary metabolite unit representation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000151 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000151">
        <obo:IAO_0000115>A measurement datum that measures the number of a particular countable entity.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/PATO_0000070</oboInOwl:hasDbXref>
        <rdfs:label>amount</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000152 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000068"/>
        <obo:IAO_0000115>A linear flux constraint that is the fixed value for linear combination of fluxes.</obo:IAO_0000115>
        <rdfs:label>flux equality constraint</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000153 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000153">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000068"/>
        <obo:IAO_0000115>A linear flux constraint that represents the upper or lower bound of linear combinations of fluxes.</obo:IAO_0000115>
        <rdfs:label>flux inequality constraint</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000154 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000154">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000226"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000301"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000171"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A representation that consists of a set of all atom identifiers considered for a molecule.</obo:IAO_0000115>
        <rdfs:label>atom map</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000155 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000155">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000226"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000070"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The representation that records the precise bijection of how each relevant atom identifier in a substrate is rearranged to form the product during a reaction.</obo:IAO_0000115>
        <rdfs:label>atom transition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000156 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000156">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000207"/>
        <obo:IAO_0000115>A statistic that is the inherent variability of repeated observation measurements of a quantity including quantities evaluated by statistical methods and by other means.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/NCIT_C71478</oboInOwl:hasDbXref>
        <rdfs:label>measurement uncertainty</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000157 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000157">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A metabolic flux analysis method that is used to quantify the flux uncertainty estimate.</obo:IAO_0000115>
        <rdfs:label>flux uncertainty quantification method</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000158 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000207"/>
        <obo:IAO_0000115>A statistic that quantify the uncertainty of the flux solution.</obo:IAO_0000115>
        <rdfs:label>flux uncertainty estimate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000159 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000159">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000058"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000016"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A data entity that specifies the parameters including flux vector and other parameters (e.g. metabolite pool sizes and model parameters) that best explains experimental data.</obo:IAO_0000115>
        <rdfs:label>flux solution</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000160 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000160">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000210"/>
        <obo:IAO_0000115>A fluxomics parameter that are necessary to run fluxomics labeling simulation.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>model parameter</oboInOwl:hasBroadSynonym>
        <rdfs:label>fluxomics model parameter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000161 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000161">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000094"/>
        <obo:IAO_0000115>A nuisance parameter that is to scale measurements of a measurement group to better fit simulated measurements.</obo:IAO_0000115>
        <rdfs:label>groupscale</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000162 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000162">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000057"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000178"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000277"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000279"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000021"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0003301"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0003301"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000126"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A completely executed planned process that aims at quantifying the fluxes of molecules in biological entities.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000182</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>fluxomics</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fluxomics study</oboInOwl:hasExactSynonym>
        <rdfs:label>fluxomics investigation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000163 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000163">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000124"/>
        <obo:IAO_0000115>A external flux indicating the rate of absorption of a molecular entity by a cell system from its surroundings.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000153</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>uptake rate</oboInOwl:hasExactSynonym>
        <rdfs:label>metabolite uptake flux</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000164 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000164">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000124"/>
        <obo:IAO_0000115>A external flux indicating the rate of release of a metabolite by a cell system to its surroundings.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000152</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>secretion rate</oboInOwl:hasExactSynonym>
        <rdfs:label>metabolite excretion flux</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000165 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000165">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000125"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0017002"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000299"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A metabolic model that represents a series of connected metabolic reactions.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000059</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>pathway</oboInOwl:hasExactSynonym>
        <rdfs:label>metabolic pathway model</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000166 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000166">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000171"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000167"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000171"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000169"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A process which uses or consumes chemical/molecular entities to generate other molecular entities.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000001</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>reaction</oboInOwl:hasExactSynonym>
        <rdfs:label>chemical reaction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000167 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000167">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000185"/>
        <obo:IAO_0000115>A reaction participant that is present at the start of a reaction and is consumed in the reaction.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>reagent</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>http://biomodels.net/SBO/SBO_0000010</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>educt</oboInOwl:hasExactSynonym>
        <rdfs:comment>It usually sits on the left side of the reaction equation.</rdfs:comment>
        <rdfs:label>reactant role</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000168 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000168">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000185"/>
        <obo:IAO_0000115>A role of a molecule or pseudo molecule which is acted upon by an enzyme.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://biomodels.net/SBO/SBO_0000015</oboInOwl:hasDbXref>
        <rdfs:label>substrate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000169 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000169">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000185"/>
        <obo:IAO_0000115>A role of a molecule or pseudo molecule which is produced from a chemical reaction.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://biomodels.net/SBO/SBO_0000011</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>product</oboInOwl:hasExactSynonym>
        <rdfs:comment>It usually sits on the right side of the reaction equation.</rdfs:comment>
        <rdfs:label>product role</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000170 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000171"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000172"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000185"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A material entity that is an electrically neutral entity consisting of more than one atom.</obo:IAO_0000115>
        <obo:IAO_0000116>Must be electrically neutral and must consist of more than one atom bonded together.</obo:IAO_0000116>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/CHEBI_25367</oboInOwl:hasDbXref>
        <rdfs:label>molecule</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000171 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000171">
        <obo:IAO_0000115>A material entity that is any constitutionally or isotopically distinct atom, molecule, ion, ion pair, radical, radical ion, complex, conformer etc., identifiable as a separately distinguishable entity.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/CHEBI_23367</oboInOwl:hasDbXref>
        <rdfs:label>molecular entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000172 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000172">
        <obo:IAO_0000112>The term &apos;metabolite&apos; subsumes the classes commonly known as primary and secondary metabolites.</obo:IAO_0000112>
        <obo:IAO_0000115>A role of a molecule that is of any intermediate or product resulting from metabolism.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/CHEBI_25212</oboInOwl:hasDbXref>
        <rdfs:label>metabolite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000173 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000173">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000217"/>
        <obo:IAO_0000115>A matrix that is a representation of a metabolic network, with rows representing metabolites and columns representing reactions. Each value indicates the stoichiometric coefficients, metabolites that are consumed are negative values and produced are positive values.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000079</oboInOwl:hasDbXref>
        <rdfs:label>stoichiometry matrix</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000174 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000174">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000031"/>
        <obo:IAO_0000115>An isomer that differs only in isotopic composition (number of isotopic substitutions).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000034</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>isotopologues</oboInOwl:hasExactSynonym>
        <rdfs:label>isotopologue</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000174"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>http://purl.obolibrary.org/obo/MSIO_0000034</owl:annotatedTarget>
        <obo:IAO_0000119>https://goldbook.iupac.org/terms/view/I03351</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000175 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000031"/>
        <obo:IAO_0000115>An isomer that is having the same number of each isotopic atom but differing in their positions.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000036</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>isotopic isomer</oboInOwl:hasExactSynonym>
        <rdfs:label>isotopomer</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000175"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>http://purl.obolibrary.org/obo/MSIO_0000036</owl:annotatedTarget>
        <obo:IAO_0000119>https://goldbook.iupac.org/terms/view/I03352</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000176 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000176">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000134"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000079"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000112>It is used in fluxomics investigation. (e.g. 13C in a 13C labelled molecular entity).</obo:IAO_0000112>
        <obo:IAO_0000112>It is used in various fields to study scientific problems by tracing the source, composition, distribution, and fate of elements or compounds.</obo:IAO_0000112>
        <obo:IAO_0000115>A processed material entity that a isotope of the tracer element which are easily detectable due to their nuclear properties,</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000031</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>isotopic label</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>isotopic marker</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tracer</oboInOwl:hasExactSynonym>
        <rdfs:label>isotopic tracer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000177 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000177">
        <obo:IAO_0000112>A cell where metabolite concentration are stable in time has reached a steady state</obo:IAO_0000112>
        <obo:IAO_0000115>a state or condition of a system or process (such as one of the energy states of an atom) that does not change in time concerned.</obo:IAO_0000115>
        <obo:IAO_0000116>A realiable entity that takes place when a system has some parts or processes of interest that do not change over time.</obo:IAO_0000116>
        <obo:IAO_0000116>A realizable entity that takes place when an entity has reached equilibrium for the measurement or phenomenon concerned.</obo:IAO_0000116>
        <obo:IAO_0000119>https://www.merriam-webster.com/dictionary/steady%20state</obo:IAO_0000119>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/NCIT_C151966</oboInOwl:hasDbXref>
        <rdfs:label>steady state</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000178 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000178">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000162"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A planned process that is intended to test a hypothesis, and describe or explain empirical data obtained under various experimental conditions.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://edamontology.org/topic_3678</oboInOwl:hasDbXref>
        <rdfs:label>experimental design and studies</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000179 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000049"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000043"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002333"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000034"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002333"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000036"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A fluxomics isotope labeling experiment in which isotopically labelled compounds are supplied to a biological system until the ratio of marked to unmarked molecules stabilizes at a constant level.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000185</oboInOwl:hasDbXref>
        <rdfs:label>isotopically steady state labeling experiment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000180 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000049"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000056"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002333"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000034"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002333"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000035"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An fluxomics isotope labeling experiment that measures the rate at which isotopically labelled compounds are incorporated into cellular metabolites over time, specifically before the system reaches a stable isotopic equilibrium.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000053</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>isotopically instationary labeling experiment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>isotopically unstationary labeling experiment</oboInOwl:hasExactSynonym>
        <rdfs:label>isotopically non-stationary labeling experiment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000181 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000181">
        <obo:IAO_0000115>A material entity that is a maximal functionally integrated unit that develops from a program encoded in a genome</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/COB_0000022</oboInOwl:hasDbXref>
        <rdfs:label>organism</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000182 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000181"/>
        <obo:IAO_0000115>An organism that is genetically different from others of the same species and possessing a set of defined characteristics.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.uniprot.org/core/strain</oboInOwl:hasDbXref>
        <rdfs:label>strain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000183 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000183">
        <obo:IAO_0000112>e.g., 6 for carbons in glucose</obo:IAO_0000112>
        <obo:IAO_0000115>A data entity that records the number of atoms of the tracer element in this metabolite.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>number of tracked atoms</oboInOwl:hasExactSynonym>
        <rdfs:label>number of traced atoms</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000184 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000184">
        <obo:IAO_0000115>A processed material that provides the needed nourishment for microorganisms or cells grown in vitro.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/OBI_0000079</oboInOwl:hasDbXref>
        <rdfs:label>culture medium</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000185 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000185">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000171"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A role that is a molecule participating in a reaction as reactant or product with an associated stoichiometric coefficient.</obo:IAO_0000115>
        <rdfs:label>reaction participant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000186 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000186">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000298"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000049"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0017001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000264"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A device which is used to measure the mass to charge ratio of ions, and it consists of three basic parts: an ion source, a mass analyzer, and a detector system.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/OBI_0000049</oboInOwl:hasDbXref>
        <rdfs:comment>The stages within the mass spectrometer are: 1. Production of ions from the sample 2. Separation of ions with different masses 3. Detection of the number of ions of each mass produced 4.Collection of data to generate the mass spectrum</rdfs:comment>
        <rdfs:label>mass spectrometer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000187 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000187">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000298"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000049"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0017001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000264"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A device which is used to carry out a nuclear magnetic resonance analysis of some sample.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/OBI_0000566</oboInOwl:hasDbXref>
        <rdfs:label>NMR instrument</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000188 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000188">
        <obo:IAO_0000115>A systematic study of metabolites, the chemical processes they are involved, and the chemical fingerprints of specific cellular processes in a whole cell, tissue, organ or organism.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://edamontology.org/topic_3172</oboInOwl:hasDbXref>
        <rdfs:label>metabolomics</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000189 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000189">
        <obo:IAO_0000115>Proteomics is in the narrow sense (sensu stricto) the application of methods to separate, characterise, identify, and quantify all proteins (the proteome) - or a substantial set of proteins - that are present in a sample.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://edamontology.org/topic_0121</oboInOwl:hasDbXref>
        <rdfs:comment>Proteomics in the broad sense is the science of proteins and peptides on the large scale.</rdfs:comment>
        <rdfs:label>proteomics</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000190 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000190">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0010001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000186"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A plan specification that is a spectrometry where the sample is converted into gaseous ions which are characterised by their mass-to-charge ratio and relative abundance.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>mass spectrometry</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/CHMO_0000470</oboInOwl:hasDbXref>
        <rdfs:label>mass spectrometry method</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000191 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000191">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000190"/>
        <obo:IAO_0000115>A mass spectrometry method where a sample mixture is first separated by liquid chromatography before being converted into ions which are characterised by their mass-to-charge ratio and relative abundance.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/CHMO_0000524</oboInOwl:hasDbXref>
        <rdfs:label>liquid chromatography-mass spectrometry</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000192 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000192">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000190"/>
        <obo:IAO_0000115>A mass spectrometry method where a sample mixture is first separated by gas chromatography then ionised and characterised according to mass-to-charge ratio and relative abundance.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/CHMO_0000497</oboInOwl:hasDbXref>
        <rdfs:label>gas chromatography-mass spectrometry</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000193 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000193">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000190"/>
        <obo:IAO_0000115>A mass spectrometry method that is involving multiple mass-selection steps, with some form of fragmentation occurring between each stage.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/CHMO_0000575</oboInOwl:hasDbXref>
        <rdfs:label>tandem mass spectrometry</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000194 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000194">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000190"/>
        <obo:IAO_0000115>A mass spectrometry method where the relative abundance of isotopes in a sample is determined.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/CHMO_0000506</oboInOwl:hasDbXref>
        <rdfs:label>isotope ratio mass spectrometry</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000195 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000195">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0010001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000187"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A plan specification that is a method to measure the energy states of spin-active nuclei placed in a static magnetic field are interrogated by inducing transitions between the states via radio frequency irradiation.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/CHMO_0000591</oboInOwl:hasDbXref>
        <rdfs:label>nuclear magnetic resonance spectroscopy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000196 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000196">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000268"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000283"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000275"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0017010"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000092"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A data transformation which aims to take into account the contribution of natural random variation in isotopic composition in the environment and adjust for it during the calculation of mass isotopologue distribution in a tracer based metabolomics experiment.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000130</oboInOwl:hasDbXref>
        <rdfs:label>isotope natural abundance correction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000197 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000197">
        <obo:IAO_0000115>A measurement datum that measures the amount of solute dissolved in a unit quantity of solvent or solution.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/STATO_0000704</oboInOwl:hasDbXref>
        <rdfs:comment>It describes the strength or intensity of a solution in terms of its solute content. It is therefore a ratio in which the numerator is a measure of the solute and the denominator is a measure of the solvent.</rdfs:comment>
        <rdfs:label>concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000198 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000226"/>
        <obo:IAO_0000115>A representation that is an entity used in a systems biology knowledge reconstruction, such as a model, pathway, network.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://biomodels.net/SBO/SBO_0000000</oboInOwl:hasDbXref>
        <rdfs:label>systems biology representation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000199 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000199">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000226"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000301"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000171"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A representation that is a specification of a chemical structure.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://edamontology.org/data_0846</oboInOwl:hasDbXref>
        <rdfs:label>chemical formula</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000200 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000200">
        <obo:IAO_0000115>A data item that represents the net charge of a molecule.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://edamontology.org/data_0845</oboInOwl:hasDbXref>
        <rdfs:label>molecular charge</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000201 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000201">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000065"/>
        <obo:IAO_0000115>A pseudo metabolic reaction that represents the reaction operating upon the internal metabolites.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://biomodels.net/SBO/SBO_0000628</oboInOwl:hasDbXref>
        <rdfs:comment>Metabolites that are consumed by these reactions are assumed to be used in intra-cellular processes that are not part of the model. Demand reactions, often represented &apos;R_DM_&apos;, can also deliver metabolites (from intra-cellular processes that are not considered in the model).</rdfs:comment>
        <rdfs:label>demand reaction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000065"/>
        <obo:IAO_0000115>A pseudo metabolic reaction that provides influx or efflux across a model boundary, for example replenishes a metabolic network with raw materials (eg carbon / energy sources).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://biomodels.net/SBO/SBO_0000627</oboInOwl:hasDbXref>
        <rdfs:comment>Such reactions are conceptual, created solely for modeling purposes, and do not have a physical correspondence. Exchange reactions, often represented as &apos;R_EX_&apos;, can operate in the negative (uptake) direction or positive (secretion) direction. By convention, a negative flux through an exchange reaction represents uptake of the corresponding metabolite, and a positive flux represent discharge.</rdfs:comment>
        <rdfs:label>exchange reaction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000065"/>
        <obo:IAO_0000115>A pseudo metabolic reaction that is an unbalanced, typically reversible reaction used to add or remove intracellular metabolites from the system.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://biomodels.net/SBO/SBO_0000632</oboInOwl:hasDbXref>
        <rdfs:comment>It is typically a reversible reaction.</rdfs:comment>
        <rdfs:label>sink reaction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000204 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000204">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000166"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An information content entity that represents the relation between the amount of substances that take part in a reaction or form a compound (typically a ratio of whole integers).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/NCIT_C18110</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>stoichiometry</oboInOwl:hasExactSynonym>
        <rdfs:label>reaction stoichiometry</rdfs:label>
        <rdfs:seeAlso>https://goldbook.iupac.org/terms/view/S06026</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000205 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000205">
        <obo:IAO_0000115>An information content entity that describes the number of molecules is taking part in a reaction.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000060</oboInOwl:hasDbXref>
        <rdfs:label>stoichiometric coefficient</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000206 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000206">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000153"/>
        <obo:IAO_0000115>A flux inequality constraint that limits the upper or lower value that a flux may assume.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://biomodels.net/SBO/SBO_0000625</oboInOwl:hasDbXref>
        <rdfs:comment>This parameter may be determined experimentally, or may be the result of theoretical investigation.</rdfs:comment>
        <rdfs:label>flux bound</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000207 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000207">
        <obo:IAO_0000115>A data item to describe a dataset or a variable, and it is generated by a calculation on set of observed data.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/STATO_0000039</oboInOwl:hasDbXref>
        <rdfs:label>statistic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000208 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000208">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000207"/>
        <obo:IAO_0000115>A statistic that is a measure of variation which correspond to the average distance from the mean of the data set to any given point of that dataset. It also corresponds to the square root of its variance.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/STATO_0000237</oboInOwl:hasDbXref>
        <rdfs:comment>It can be for a random variable, statistical population, data set, or probability distribution.</rdfs:comment>
        <rdfs:label>standard deviation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000209 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000209">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000207"/>
        <obo:IAO_0000115>A statistic which defines an range of values in which a measurement or trial falls corresponding to a given probability.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/STATO_0000196</oboInOwl:hasDbXref>
        <rdfs:label>confidence interval</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000210 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000210">
        <obo:IAO_0000115 xml:lang="en">A data item that is required to run a fluxomics investigation.</obo:IAO_0000115>
        <rdfs:label>fluxomics parameter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000211 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000211">
        <obo:IAO_0000115>A data transformation that performs statistical inference to decide whether the data provide sufficient evidence to reject a particular hypothesis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/OBI_0000673</oboInOwl:hasDbXref>
        <rdfs:label>statistical hypothesis test</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000212 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000212">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000211"/>
        <obo:IAO_0000115>A statistical hypothesis test that aims to evaluate if a sample distribution can be considered equivalent to a theoretical distribution used as input.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/STATO_0000191</oboInOwl:hasDbXref>
        <rdfs:label>goodness of fit statistical test</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000213 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000213">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000211"/>
        <obo:IAO_0000115>A statistical hypothesis test that the sampling distribution of the test statistic is a chi-square distribution when the null hypothesis is true, or any in which this is asymptotically true.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/OBI_0200200</oboInOwl:hasDbXref>
        <rdfs:label>chi-square test</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000214 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000214">
        <obo:IAO_0000115>The data transformation that finds parameter values (the model parameter estimates) most compatible with the data as judged by the model.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/STATO_0000119</oboInOwl:hasDbXref>
        <rdfs:label>model parameter estimation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000215 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000215">
        <obo:IAO_0000115>A data transformation that is estimating properties of an estimator (such as its variance) by measuring those properties when sampling from an approximating distribution.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/STATO_0000548</oboInOwl:hasDbXref>
        <rdfs:label>sampling distribution estimation by bootstrapping</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000216 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000216">
        <obo:IAO_0000115>An information content entity which is a formalization of relationships between variables in the form of mathematical equations. A statistical model describes how one or more random variables are related to one or more other variables. The model is statistical as the variables are not deterministically but stochastically related.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/STATO_0000107</oboInOwl:hasDbXref>
        <rdfs:label>statistical model</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000217 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000217">
        <obo:IAO_0000115>An information content entity that is a rectangular array of numbers, which are called entries of the matrix.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/STATO_0000642</oboInOwl:hasDbXref>
        <rdfs:label>matrix</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000218 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000218">
        <obo:IAO_0000115>An information content entity that represents a set of process conditions, grouping relevant process control variables and process measurement variables, describing the environmental and physicochemical conditions under which cells are cultivated.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://edamontology.org/data_3724</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/PREFER_0000008</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>fermentation culture condition</oboInOwl:hasExactSynonym>
        <rdfs:label>cultivation condition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000219 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000219">
        <obo:IAO_0000115>A measurement unit label which represents a standard measurement occurrence of a process per unit time.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/UO_0000280</oboInOwl:hasDbXref>
        <rdfs:label>rate unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000220 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000220">
        <obo:IAO_0000115>A measurement unit label which is a standardised quantity of an element or compound with uniform composition.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/UO_0000006</oboInOwl:hasDbXref>
        <rdfs:label>substance unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000221 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000221">
        <obo:IAO_0000115>A measurement unit label which is a standard measure of the dimension in which events occur in sequence.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/UO_0000003</oboInOwl:hasDbXref>
        <rdfs:label>time unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000222 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000222">
        <obo:IAO_0000115>A measurement unit label which represents a standard measurement of how much of a given substance there is mixed with another substance.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/UO_0000051</oboInOwl:hasDbXref>
        <rdfs:label>concentration unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000223 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000223">
        <obo:IAO_0000115>An information content entity that is the formal representation of a calculus linking parameters and variables of a model.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://biomodels.net/SBO/SBO_0000064</oboInOwl:hasDbXref>
        <rdfs:label>mathematical expression</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000224 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000224">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000155"/>
        <obo:IAO_0000115>An atom transition that represents an alternative atom transition of the original reaction.</obo:IAO_0000115>
        <rdfs:label>atom transition variant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000225 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000225">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000038"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A device that is designed to support the run of a biological and biochemical process by controlling regulated environmental and cultivation conditions.</obo:IAO_0000115>
        <obo:IAO_0000116>The bioreactor can typically control factors like temperature, agitation or nutrient injection at different scales, including lab-scale, pilot plant, and industrial-scale systems.</obo:IAO_0000116>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/PREFER_0000014</oboInOwl:hasDbXref>
        <rdfs:label>bioreactor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000226 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000226">
        <obo:IAO_0000115>An information content entity that is in some way represents another entity (or attribute thereof).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://semanticscience.org/resource/SIO_000612</oboInOwl:hasDbXref>
        <rdfs:label>representation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000227 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000227">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000289"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0017010"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000228"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An information content entity that contains some data entity and is specified by file attributes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://nmrML.org/nmrCV#NMR:1400267</oboInOwl:hasDbXref>
        <rdfs:label>data file</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000228 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000228">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0017002"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000227"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An information content entity that characterizes the data file.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://nmrML.org/nmrCV#NMR:1000011</oboInOwl:hasDbXref>
        <rdfs:label>data file attribute</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000229 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000229">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000228"/>
        <obo:IAO_0000115>A data file attribute that defines the format of the information is stored in and each is given a shorthand name.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://nmrML.org/nmrCV#NMR:1001459</oboInOwl:hasDbXref>
        <rdfs:label>data file format</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000230 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000230">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000229"/>
        <obo:IAO_0000115>A data file format that is stored as tabular data through comma-separated values in a text file.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://edamontology.org/format_3752</oboInOwl:hasDbXref>
        <rdfs:label>CSV format</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000231 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000231">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000229"/>
        <obo:IAO_0000115>A data file format that is the binary format defined by MATLAB software to store workspace variables.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://edamontology.org/format_3626</oboInOwl:hasDbXref>
        <rdfs:label>MAT format</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000232 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000232">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000229"/>
        <obo:IAO_0000115>A data file format that is stored as tabular data through tab-separated values in a text file.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://edamontology.org/format_3475</oboInOwl:hasDbXref>
        <rdfs:label>TSV format</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000233 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000233">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000261"/>
        <obo:IAO_0000115>An XML format that is developed by Microsoft for MS Excel software, and it is composed of a set of XML documents stored in a ZIP-compressed file.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://edamontology.org/format_3620</oboInOwl:hasDbXref>
        <rdfs:label>xlsx format</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000234 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000234">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000229"/>
        <obo:IAO_0000115>A data file format that is a lightweight, text-based format to represent tree-structured data using key-value pairs, and is defined by JavaScript Object Notation specification.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://edamontology.org/format_3464</oboInOwl:hasDbXref>
        <rdfs:label>JSON format</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000235 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000235">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000261"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0017010"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000282"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An XML format that is used for models of biological processes and is defined by the Systems Biology Markup Language (SBML) specification.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://edamontology.org/format_2585</oboInOwl:hasDbXref>
        <rdfs:label>SBML format</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000236 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000236">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000166"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A data item which represents the speed of a chemical reaction turning reactive species into product species of event (i.e the number of such conversions) occuring over a time interval.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/STATO_0000071</oboInOwl:hasDbXref>
        <rdfs:label>reaction rate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000237 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000237">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000207"/>
        <obo:IAO_0000115>A statistic which is obtained by dividing the sum of squared residuals (SSR) by the number of degrees of freedom</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/STATO_0000375</oboInOwl:hasDbXref>
        <rdfs:label>residual mean square</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000238 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000238">
        <obo:IAO_0000115>An identifier of an entry from a database of chemicals.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://edamontology.org/data_1086</oboInOwl:hasDbXref>
        <rdfs:label>compound identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000239 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000239">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000238"/>
        <obo:IAO_0000115>The compound identifier that is based on the chemical structure specified in IUPAC International Chemical Identifier (InChI) line notation.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://edamontology.org/format_1197</oboInOwl:hasDbXref>
        <rdfs:label>InChI identifier</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000239"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>http://edamontology.org/format_1197</owl:annotatedTarget>
        <obo:IAO_0000119>https://pmc.ncbi.nlm.nih.gov/articles/PMC4486400/</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000240 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000240">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000238"/>
        <obo:IAO_0000115>A compound identifier that is the chemical structure specified in Simplified Molecular Input Line Entry System (SMILES) line notation.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://edamontology.org/format_1196</oboInOwl:hasDbXref>
        <rdfs:label>SMILES identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000241 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000241">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000219"/>
        <obo:IAO_0000115>A rate unit that measures the substance amount by cell quantity and time.</obo:IAO_0000115>
        <rdfs:comment>Several commonly used metabolic flux units are per volume: nmol ⋅ hr⁻¹ ⋅ μl⁻¹ of cells or mol ⋅ hr⁻¹ ⋅ cell⁻¹ and per biomass: mmol ⋅ gDW⁻¹ ⋅ hr⁻¹ (where gDW stands for grams of dry cell weight).</rdfs:comment>
        <rdfs:label>metabolic flux unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000242 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000242">
        <obo:IAO_0000115>A quality that shows a characteristic of software.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://nmrML.org/nmrCV#NMR:1000353</oboInOwl:hasDbXref>
        <rdfs:label>software property</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000243 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000243">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000242"/>
        <obo:IAO_0000115>An information about software which is a sequence of characters borne by part of each of a class of manufactured products or its packaging and indicates its order within a set of other products having the same name.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/IAO_0000129</oboInOwl:hasDbXref>
        <rdfs:label>version number</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000244 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000244">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is a high-performance software suite for steady-state 13C-MFA featuring efficient cumomer and EMU simulation algorithms, arbitrary measurement specifications, FluxML standardized file format, and bindings for optimization frameworks like IPOPT (Weitzel et al., Bioinformatics, 2013, DOI: 10.1093/bioinformatics/bts646).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000042</oboInOwl:hasDbXref>
        <rdfs:label>13CFLUX2</rdfs:label>
        <foaf:homepage>https://www.13cflux.net/13cflux2/index.html</foaf:homepage>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000244"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>http://purl.obolibrary.org/obo/MSIO_0000042</owl:annotatedTarget>
        <obo:IAO_0000119>https://doi.org/10.1093/bioinformatics/bts646</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000245 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000245">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is a user-friendly software package for 13C metabolic flux analysis that automatically calculates flux ratios from GC-MS-detected 13C patterns in protein-bound amino acids, and then estimates net fluxes from extracellular flux measurements and the determined ratios (Zamboni et al., BMC Bioinformatics, 2005, DOI: 10.1186/1471-2105-6-209).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000044</oboInOwl:hasDbXref>
        <rdfs:label>FiatFlux</rdfs:label>
        <foaf:homepage>https://imsb.ethz.ch/research/zamboni/resources/fiatflux.html</foaf:homepage>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000245"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>http://purl.obolibrary.org/obo/MSIO_0000044</owl:annotatedTarget>
        <obo:IAO_0000119>https://doi.org/10.1186/1471-2105-6-209</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000246 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000246">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is a MATLAB-based toolbox for targeted 13C metabolic flux ratio analysis using surrogate modeling, generating random metabolic flux distributions and 13C labeling patterns, then training machine learning models to predict specific flux ratios from measured labeling data (Kogadeeva and Zamboni, PLOS Comput Biol, 2016, DOI: 10.1371/journal.pcbi.1005109).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000057</oboInOwl:hasDbXref>
        <rdfs:label>SUMOFLUX</rdfs:label>
        <foaf:homepage>https://github.com/zamboni-lab/sumoflux</foaf:homepage>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000246"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>http://purl.obolibrary.org/obo/MSIO_0000057</owl:annotatedTarget>
        <obo:IAO_0000119>https://doi.org/10.1371/journal.pcbi.1005109</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000247 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000247">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is a MATLAB-based 13C-MFA software based on the Elementary Metabolite Unit (EMU) framework, supporting steady-state MFA, tracer experiment design, and statistical analysis (Antoniewicz et al., Metab Eng, 2007, DOI: 10.1016/j.ymben.2006.09.001).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000051</oboInOwl:hasDbXref>
        <rdfs:label>metran</rdfs:label>
        <foaf:homepage>https://tlo.mit.edu/industry-entrepreneurs/available-technologies/metran-software-13c-metabolic-flux-analysis</foaf:homepage>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000247"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>http://purl.obolibrary.org/obo/MSIO_0000051</owl:annotatedTarget>
        <obo:IAO_0000119>https://doi.org/10.1074/jbc.M706494200</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000248 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000248">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is an open-source MATLAB/Java-based modelling software for 13C metabolic flux analysis implementing the EMU technique, featuring a Java GUI for model generation and MATLAB-based flux analysis (Quek et al., Microb Cell Fact, 2009, DOI: 10.1186/1475-2859-8-25).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000035</oboInOwl:hasDbXref>
        <rdfs:label>OpenFLUX</rdfs:label>
        <foaf:homepage>https://openflux.sourceforge.net/</foaf:homepage>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000248"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>http://purl.obolibrary.org/obo/MSIO_0000035</owl:annotatedTarget>
        <obo:IAO_0000119>https://doi.org/10.1186/1475-2859-8-25</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000249 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000249">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software based on MATLAB that was the first publicly available software to perform both steady-state and isotopically non-stationary 13C-MFA, using the EMU framework and supporting parallel labeling experiments, goodness-of-fit testing, and confidence interval estimation (Young, Bioinformatics, 2014, DOI: 10.1093/bioinformatics/btu015).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000047</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Isotopomer Network Compartmental Analysis</oboInOwl:hasExactSynonym>
        <rdfs:label>INCA</rdfs:label>
        <foaf:homepage>https://mfa.vueinnovations.com/</foaf:homepage>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000249"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>http://purl.obolibrary.org/obo/MSIO_0000047</owl:annotatedTarget>
        <obo:IAO_0000119>https://doi.org/10.1093/bioinformatics/btu015</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000250 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000250">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is a Python-based flux analysis software that allows to perform 13C Metabolic Flux Analysis on a sub-network of a large scale model.</obo:IAO_0000115>
        <obo:IAO_0000600>Iso2flux uses constraint-based modelling to compute steady state fluxes across a large metabolic network and uses such flxues to predict 13C distribution across a subser of the newtork. Then, given a set of 13C data Iso2flux can iteratively find the steady state flux distributions that are most consistent with such fluxes.</obo:IAO_0000600>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000048</oboInOwl:hasDbXref>
        <rdfs:label>iso2flux</rdfs:label>
        <foaf:homepage>https://github.com/cfoguet/iso2flux</foaf:homepage>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000251 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000251">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis software that is a C++-program that performs an analysis of stable isotope tracer data to assess metabolic flux profiles in living cells.</obo:IAO_0000115>
        <obo:IAO_0000600>Isodyn simulates the dynamics of isotopic isomer (isotopomer) distribution in central metabolic pathways, and, by changing its parameters, which reflect the characteristics of corresponding biochemical reactions, fit the simulated dynamics of mass isotopomers to that observed experimentally. The simulated metabolic fluxes that correspond to the best fit are assumed to reproduce the real fluxes in the analyzed biological object and conditions. Isodyn contains tools that check the goodness of fit and perform a statistical analysis of obtained metabolic fluxes.</obo:IAO_0000600>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000049</oboInOwl:hasDbXref>
        <rdfs:label>isodyn</rdfs:label>
        <foaf:homepage>https://bio.tools/Isodyn</foaf:homepage>
        <foaf:homepage>https://github.com/seliv55/isodyn</foaf:homepage>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000252 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000252">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000103"/>
        <obo:IAO_0000115>A metabolic flux analysis softwaresoftware that enables these parameters to be maximized by optimizing the isotopic composition of the label input.</obo:IAO_0000115>
        <obo:IAO_0000600>It can be applied to (13) C-MFA investigations using a broad panel of analytical tools (MS, MS/MS, (1) H NMR, (13) C NMR, etc.) individually or in combination. It includes a visualization module to intuitively select the optimal label input depending on the biological question to be addressed.</obo:IAO_0000600>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/MSIO_0000050</oboInOwl:hasDbXref>
        <rdfs:label>IsoDesign</rdfs:label>
        <foaf:homepage>https://isodesign.readthedocs.io/en/latest/</foaf:homepage>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000253 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000253">
        <obo:IAO_0000115>A material entity that has certain capacities or attributes constituting personhood.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://xmlns.com/foaf/0.1/Person</oboInOwl:hasDbXref>
        <rdfs:label>person</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000254 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000254">
        <obo:IAO_0000115>An identifier of a software end-user on a website or a database (typically a person or an entity).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://edamontology.org/data_2118</oboInOwl:hasDbXref>
        <rdfs:label>person identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000255 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000254"/>
        <obo:IAO_0000115>A person identifier that consists of the word or words that a person is known by.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/IAO_0020015</oboInOwl:hasDbXref>
        <rdfs:label>person name</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000256 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000256">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000254"/>
        <obo:IAO_0000115>A person identifier of a researcher registered with the ORCID database.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/IAO_0000708</oboInOwl:hasDbXref>
        <rdfs:label>ORCID Identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000257 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000257">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000254"/>
        <obo:IAO_0000115>A person identifier that is an address of an end-user.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/IAO_0000429</oboInOwl:hasDbXref>
        <rdfs:label>Email address</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000258 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000258">
        <obo:IAO_0000115>A material entity that can bear roles, has members, and has a set of organization rules.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/OBI_0000245</oboInOwl:hasDbXref>
        <rdfs:comment>Members of organizations are either organizations themselves or individual people. Members can bear specific organization member roles that are determined in the organization rules. The organization rules also determine how decisions are made on behalf of the organization by the organization members.</rdfs:comment>
        <rdfs:label>organization</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000259 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000259">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000188"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A planned process that is the study of metabolic fluxes of the reactions in a metabolic network.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>metabolic flux analysis</oboInOwl:hasExactSynonym>
        <rdfs:label>fluxomics</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000209"/>
        <obo:IAO_0000115>a confidence interval which covers 95% of the sampling distribution, meaning that there is a 5% risk of false positive (type I error).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/STATO_0000231</oboInOwl:hasDbXref>
        <rdfs:comment>If the number of observations made is large enough, the sampling distribution can be assumed to be normal, which entails that 95% of the sampling distributions falls within roughly2 (1.96) standard deviations from the mean.</rdfs:comment>
        <rdfs:label>95% confidence interval</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000261 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000261">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000229"/>
        <obo:IAO_0000115>A data file format that is a flexible text format used to store and transport structured data, and is defined by Extensible Markup Language specification.</obo:IAO_0000115>
