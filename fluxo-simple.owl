    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/fluxo/fluxo-simple.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/fluxo/releases/2026-09-04/fluxo-simple.owl"/>
        <dc:contributor>Te Chen
Sergi Muyo Abad
Shawn Tan
Katharina Nöh
Pierre Millard
Martin Beyß
Txell Amigo
Matthias Mattanovich
Nicholas Luke Cowie
Edward Teddy Groves
Lars Keld Nielsen</dc:contributor>
        <dc:description>Metabolic Flux Analysis Ontology is an ontology that provides a structured framework for representing concepts, relationships, and data related to metabolic flux analysis.</dc:description>
        <dc:title>Metabolic Flux Analysis Ontology</dc:title>
        <terms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
        <owl:versionInfo>2026-04-08</owl:versionInfo>
        <owl:versionInfo>2026-09-04</owl:versionInfo>
    </owl:Ontology>
    


