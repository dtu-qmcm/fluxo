        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000269"/>
        <obo:IAO_0000115>A mass that is the rounded exact mass of molecule to the nearest integer.</obo:IAO_0000115>
        <rdfs:label>nominal molecular mass</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000272 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000272">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000269"/>
        <obo:IAO_0000115>A mass that is the calculated mass of a molecule based on the exact atomic masses of its constituent isotopes.</obo:IAO_0000115>
        <rdfs:label>exact molecular mass</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000273 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000273">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLUXO_0000269"/>
        <obo:IAO_0000115>A mass that is the theoretical mass of a molecule if it were composed 100% of the lightest, most abundant natural isotopes.</obo:IAO_0000115>
        <rdfs:label>monoisotopic molecular mass</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FLUXO_0000274 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FLUXO_0000274">
        <obo:IAO_0000115>A data entity that categorizes isotopologues based on how many heavy isotopes (extra neutrons) they contain compared to the monoisotopic mass (M0).</obo:IAO_0000115>
        <rdfs:label>nominal molecular mass shift</rdfs:label>
    </owl:Class>
    


